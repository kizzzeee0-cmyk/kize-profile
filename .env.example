# KIZE now uses Cloudflare Pages Functions + GitHub storage.
# Do NOT put these values in Vite client variables.
# Configure them in Cloudflare Pages > Settings > Variables and Secrets.

ADMIN_PASSWORD=CHANGE_ME
SESSION_SECRET=LONG_RANDOM_SECRET
GITHUB_TOKEN=github_pat_xxxxxxxxx

# Optional overrides; defaults are already kizzzeee0-cmyk / kize-profile / main.
GITHUB_OWNER=kizzzeee0-cmyk
GITHUB_REPO=kize-profile
GITHUB_BRANCH=main

# Optional WEFLAB webhook shared secret.
WEFLAB_WEBHOOK_TOKEN=CHANGE_ME_IF_USED
